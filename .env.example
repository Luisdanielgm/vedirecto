# --- Cauce (LLM para extraer datos + triage de seguridad al agregar un sitio) ---
CAUCE_API_KEY=cau_live_tu_clave_aqui
CAUCE_BASE_URL=https://api.cauce.me/v1
CAUCE_MODEL=deepseek-v4-flash

# Topes diarios de análisis con IA (protegen tus créditos de Cauce). Cada preview
# o alta directa gasta un llamado. Se reinician a las 00:00 UTC. Opcionales.
MAX_ANALISIS_USUARIO_DIA=30
MAX_ANALISIS_DIA=200

# --- Supabase (login con Google para habilitar "Agregar sitio"). Son PÚBLICOS. ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_anon_publishable_key

# --- Datos ---
# Carpeta del volumen donde vive la base SQLite. En Docker = /app/data.
DATA_DIR=./data

# --- Admin: email de la cuenta Google que puede borrar sitios (runtime, no se hornea) ---
ADMIN_EMAIL=tu-correo@gmail.com

# --- Métricas: sal para el hash de visitantes únicos (cuenta únicos SIN guardar IP).
# Opcional pero recomendado: poné una cadena secreta y larga. Si no se setea, usa un
# valor por defecto público (igual sirve, pero menos robusto en un repo abierto). ---
VISIT_SALT=cambia-esto-por-algo-secreto-y-largo

# --- Cron: secreto para que un scheduler externo dispare los endpoints /api/cron/*
# (noticias y backup) sin sesión admin (header x-cron-secret o ?secret=). Si no se
# setea, solo el admin logueado puede dispararlos. ---
CRON_SECRET=cambia-esto-por-algo-secreto
